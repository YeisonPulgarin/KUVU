export type Create{{FEATURE_PASCAL}}Input = z.infer<typeof create{{FEATURE_PASCAL}}Schema>
export type Update{{FEATURE_PASCAL}}Input = z.infer<typeof update{{FEATURE_PASCAL}}Schema>
