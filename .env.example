# Local database credentials.
#
# Copy to .env and fill in real values before the first `docker compose up -d`.
# .env is gitignored: never commit real passwords.

# Host port where the database is published. 3306 is what the backend expects
# by default, and what external clients (Workbench, DBeaver, DataGrip, TablePlus)
# expect. Change it only if something else already holds the port.
DB_PORT=3306

# Database name. Must match USE bd_arrendamientos in db/init/*.sql
DB_NAME=bd_arrendamientos

# Password for the root user. Administration only.
DB_ROOT_PASSWORD=CHANGE_ME_root_password

# Application user. This is what backend/.env connects with.
DB_APP_USER=kuvu_app
DB_APP_PASSWORD=CHANGE_ME_app_password
