{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx ng build",
  "outputDirectory": "dist/proyecto-dss/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://RAILWAY_BACKEND_HOST/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
